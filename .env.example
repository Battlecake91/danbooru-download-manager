# Host directory containing both Manager data and year/category image folders.
DANBOORU_ARCHIVE_DIR=/path/to/images

# Change only this value when a new archive year starts.
DANBOORU_ARCHIVE_YEAR=2026

# Use 0.0.0.0 for access from a trusted local network.
DANBOORU_WEB_BIND=127.0.0.1
PUID=1000
PGID=1000

# Required only when the desktop application connects in Remote Docker mode.
DANBOORU_DESKTOP_API_TOKEN=
